# Copy this file to ".env" and change the values.
# Password-la @ # : / mathiri special characters irundha URL-encode pannunga (@ -> %40, # -> %23)
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/masala_store

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First admin (auto-created on first start)
ADMIN_EMAIL=admin@masalaworld.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Masala Admin

# Storefront (5173) and admin app (5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

FREE_SHIPPING_ABOVE=349
SHIPPING_FEE=40
LOW_STOCK_LIMIT=10
