# Copy this file to ".env" and change the values.
# Password-la @ # : / mathiri special characters irundha URL-encode pannunga (@ -> %40, # -> %23)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/masala_store
SECRET_KEY=your-super-secret-jwt-key-here-min-32-chars
ADMIN_PASSWORD=your-admin-password
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First admin (auto-created on first start)
ADMIN_EMAIL=admin@masalaworld.com

ADMIN_NAME=Masala Admin

# Storefront (5173) and admin app (5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

FREE_SHIPPING_ABOVE=349
SHIPPING_FEE=40
LOW_STOCK_LIMIT=10
